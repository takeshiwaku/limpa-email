# Modelo de configuracao. Copie este arquivo para .env e preencha os valores.
# O arquivo .env NAO deve ser comitado (ja esta no .gitignore).

# Qual provedor usar por padrao: yahoo ou gmail
PROVEDOR=yahoo

# --- Yahoo ---
YAHOO_EMAIL=voce@yahoo.com
YAHOO_APP_PASSWORD=sua_app_password_aqui

# --- Gmail ---
# Requer verificacao em 2 etapas ativada e IMAP habilitado no Gmail.
# Gere em: Conta Google -> Seguranca -> Senhas de app (use o valor SEM espacos).
GMAIL_EMAIL=voce@gmail.com
GMAIL_APP_PASSWORD=sua_app_password_do_google

# Opcional: tamanho do lote de leitura no descobrir_remetentes.py
# (emails buscados por chamada IMAP). Padrao 500. Reduza se o servidor reclamar.
LOTE=500
